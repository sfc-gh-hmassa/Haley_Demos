    {
      "type": "numberedPoints",
      "kicker": "FINDINGS",
      "title": "What the data says",
      "points": [
        {
          "number": "1",
          "header": "SP wrappers cost 3.1x",
          "body": "Text-only returns force the master to re-call sub-agents: 806K tokens and 102 s per question vs 257K and 23 s."
        },
        {
          "number": "2",
          "header": "Few domains: agent_toolset is fine",
          "body": "No extra cost versus the alternatives. Semantic views are fetched only for the selected tool."
        },
        {
          "number": "3",
          "header": "'full' caused the MCP penalty",
          "body": "Each call returned ~142 KB of trace. compact or a CEL filter cuts it by 97\u201399%."
        },
        {
          "number": "4",
          "header": "At scale, delegation stays flat",
          "body": "agent_toolset +53% at 30 tools. MCP delegation ~0.95\u20130.98x."
        }
      ]
    },
