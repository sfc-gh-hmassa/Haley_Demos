    {
      "type": "numberedPoints",
      "kicker": "THE PROBLEM",
      "title": "What the architecture has to do",
      "points": [
        {
          "number": "1",
          "header": "Isolate context",
          "body": "Each domain sub-agent owns ~17\u201319K-token semantic views. They should not land in the master's context window."
        },
        {
          "number": "2",
          "header": "Return structure, not text",
          "body": "The front end needs tables and charts from sub-agent results, not a text summary."
        },
        {
          "number": "3",
          "header": "Scale to many domains",
          "body": "14 domains \u00d7 AGG/BASE views \u2248 30 analyst tools. Cost and routing must hold up."
        }
      ],
      "footerNote": {
        "title": "THE CONCERN",
        "body": "Observed 60\u201370% higher token use with MCP-based sub-agent calls, plus concern that agent_toolset flattens every tool into the master."
      }
    },
