      "type": "table",
      "title": "Architecture decision guide",
      "headers": [
        "Situation",
        "Recommendation"
      ],
      "rows": [
        [
          "Using SP / DATA_AGENT_RUN wrappers today",
          "Replace them (3.1x tokens, lossy numbers)"
        ],
        [
          "2\u20135 sub-agents, few tools each",
          "agent_toolset: simplest, native charts, same cost"
        ],
        [
          "Many domains with near-duplicate views (AGG/BASE)",
          "Consolidate semantic views to 4\u20136 domains, keep agent_toolset"
        ],
        [
          "Many domains, need isolation",
          "MCP delegation with compact or a CEL filter"
